# =====================================================================
# Surge Controller — runtime configuration
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# =====================================================================

# ---------------------------------------------------------------------
# 1) NEXTAUTH_SECRET  (REQUIRED if you use GitHub login on the public domain)
# ---------------------------------------------------------------------
# Purpose: signs the session cookie / JWT issued by next-auth after a
#          successful GitHub OAuth login. If this leaks, anyone can forge
#          a session and bypass GitHub.
# How to generate (any one of these works, just pick one):
#   openssl rand -base64 32
#   # or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Length: 32 random bytes (≈ 44 base64 chars). Treat it like a password.
NEXTAUTH_SECRET=replace-me

# Public URL where the app is reachable from the internet. Used by next-auth
# to build OAuth callback URLs. Must match exactly what you register in GitHub.
# Example: https://surge.onenew.site
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 2) APP_ENC_KEY  (REQUIRED)
# ---------------------------------------------------------------------
# Purpose: AES-256-GCM key used to encrypt sensitive values stored in
#          SQLite (currently: your subscription URL, which contains a
#          private token). Different from NEXTAUTH_SECRET on purpose:
#          rotating one should not invalidate the other.
# How to generate:
#   openssl rand -base64 32
# Length: 32 random bytes (≈ 44 base64 chars).
# NOTE: if you change this after data has been written, previously stored
#       encrypted values (subscription URL) become unreadable and must be
#       re-entered in the UI.
APP_ENC_KEY=replace-me

# ---------------------------------------------------------------------
# 3) GitHub OAuth App  (REQUIRED for public-domain access; optional for LAN-only)
# ---------------------------------------------------------------------
# Create at: https://github.com/settings/developers  → "New OAuth App"
#   Homepage URL:               https://surge.onenew.site
#   Authorization callback URL: https://surge.onenew.site/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Comma-separated GitHub usernames allowed to sign in. Leave empty to allow any.
ALLOWED_GITHUB_LOGINS=bushicherry

# ---------------------------------------------------------------------
# 4) LAN bypass  (RECOMMENDED for home-network use)
# ---------------------------------------------------------------------
# Any incoming request whose HTTP Host header EXACTLY matches one of these
# entries skips all authentication. Use this to access the controller
# from your phone on the same Wi-Fi without going through GitHub / Cloudflare.
#
# Match rules:
#   - Case-insensitive
#   - Must include the port if you serve on a non-standard one (e.g. :3000)
#   - The container itself sees the original Host header that the client sent,
#     so you list whatever URL you actually type into the browser / Shortcut.
#
# Examples (uncomment & edit):
#   LAN_TRUSTED_HOSTS=192.168.1.50:3000,my-mac.local:3000,localhost:3000
#
# IMPORTANT: do NOT include your public Cloudflare hostname here, and do NOT
# include 127.0.0.1 if cloudflared runs on the same host (it would let
# anyone-via-tunnel bypass auth).
LAN_TRUSTED_HOSTS=

# ---------------------------------------------------------------------
# 5) Surge HTTP API  (REQUIRED)
# ---------------------------------------------------------------------
# In your Surge profile add (or let this app inject) a line like:
#   http-api = surgepasswd@0.0.0.0:6171
# The host must be 0.0.0.0 (not 127.0.0.1) so Docker can reach it via
# host.docker.internal.
#
# When running in Docker, set SURGE_API_HOST to host.docker.internal:
#   SURGE_API_HOST=http://host.docker.internal:6171
# When running natively (yarn start on the Mac itself):
#   SURGE_API_HOST=http://127.0.0.1:6171
SURGE_API_HOST=http://host.docker.internal:6171
SURGE_API_KEY=surgepasswd

# ---------------------------------------------------------------------
# 6) Surge profile file  (REQUIRED)
# ---------------------------------------------------------------------
# This is the file the subscription updater writes to, and that Surge then
# reloads. In Docker we mount it into the container — see HOST_SURGE_PROFILE
# below. The path inside the container is fixed by docker-compose.yml.
#
# Native (non-Docker) value would be something like:
#   /Users/li.chen/Library/Application Support/Surge/Profiles/Default.conf
SURGE_PROFILE_PATH=/surge/profile.conf

# ---------------------------------------------------------------------
# 7) Docker-only: where on the Mac the Surge profile lives
# ---------------------------------------------------------------------
# docker-compose.yml mounts this host path into the container at
# /surge/profile.conf. MUST be an absolute path. Spaces are fine (compose
# handles the quoting from .env_file). Example:
HOST_SURGE_PROFILE=/Users/li.chen/Library/Application Support/Surge/Profiles/Default.conf

# ---------------------------------------------------------------------
# 8) Misc
# ---------------------------------------------------------------------
# User-Agent used when fetching the subscription URL (some providers gate by UA).
SURGE_UA=Surge/2650

# SQLite path. Inside Docker this is /data/app.db (a mounted volume).
DB_PATH=/data/app.db
