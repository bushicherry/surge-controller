# =====================================================================
# Surge Controller — NATIVE (yarn start + launchd) config template
# Target: Intel Mac, macOS Monterey 12.7.2, LAN-only, no Docker.
#
# On the TARGET Mac:
#   cp .env.native.example .env.local
#   # then edit the 3 values marked "EDIT ON TARGET" below.
# Never commit .env.local.
# =====================================================================

# --- Secrets (pre-generated; fine to keep, or regenerate with:
#      openssl rand -base64 32 ) -----------------------------------------
NEXTAUTH_SECRET=+SNO7JgwgXyyhZSLmTLDzuKvtsGxZ/JPa9Wtg4pQL70=
APP_ENC_KEY=IBylys9WGLLTUYCNGDEIcmui0A3rrqI+yqnWj3uYMFs=

# LAN-only: no public URL / OAuth needed. Leave as-is.
NEXTAUTH_URL=http://localhost:3000
GITHUB_ID=
GITHUB_SECRET=
ALLOWED_GITHUB_LOGINS=

# --- LAN bypass  (EDIT ON TARGET) ------------------------------------
# Put the target Mac's LAN IP + port here so phones skip auth.
# Find it on the target:  ipconfig getifaddr en0   (try en1 if empty)
# Must EXACTLY match what you type in the browser (include :3000).
LAN_TRUSTED_HOSTS=192.168.1.50:3000,localhost:3000

# --- Surge HTTP API  (native → 127.0.0.1) ----------------------------
# In native mode Surge's http-api can (and should) bind to 127.0.0.1,
# not 0.0.0.0 — the controller runs on the same Mac.
#   [General]  http-api = <SURGE_API_KEY>@127.0.0.1:6171
SURGE_API_HOST=http://127.0.0.1:6171
SURGE_API_KEY=surgepasswd

# --- Surge profile path  (EDIT ON TARGET) ----------------------------
# Absolute path to the profile Surge currently loads on the target Mac.
# The username / filename likely differ from the dev machine.
# Find it: Surge menu → Profiles → "Show in Finder" → right-click →
#          "Copy as Pathname". Spaces are OK, do NOT add quotes.
SURGE_PROFILE_PATH=/Users/YOUR_USER/Library/Application Support/Surge/Profiles/Airport.conf

# --- Misc ------------------------------------------------------------
SURGE_UA=Surge/2650
# Relative path is fine in native mode; resolves under the project dir.
DB_PATH=./data/app.db
